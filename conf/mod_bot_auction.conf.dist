###################################################################################################
#                                                                                                 #
#                      BYG80S DYNAMIC AUCTION HOUSE SYSTEM - CONFIGURATION V2                     #
#                                                                                                 #
###################################################################################################

[worldserver]

#
#    BotAuction.Enable
#        Descripción: Activa o desactiva el sistema completo de subastas dinámicas.
#        Default:     1 (Activado)
BotAuction.Enable = 1

#
#    BotAuction.UpdateInterval
#        Descripción: Tiempo de espera entre cada ciclo de revisión del bot (en milisegundos).
#        Default:     30000 (30 segundos)
BotAuction.UpdateInterval = 30000

#
###################################################################################################
# SECCIÓN 1: SISTEMA DE VENTAS (BOT -> AH)
###################################################################################################
#
#    BotAuction.MaxBotAuctions
#        Descripción: Cantidad máxima de objetos que los bots pondrán en total en el mundo.
BotAuction.MaxBotAuctions = 1500

#
#    BotAuction.MaxPerHouse
#        Descripción: Límite de objetos por cada casa (Alianza, Horda, Neutral).
BotAuction.MaxPerHouse = 700

#
#    BotAuction.ItemsPerCycle
#        Descripción: Cuántos items nuevos pone el bot a la venta cada vez que se actualiza.
BotAuction.ItemsPerCycle = 10

#
###################################################################################################
# SECCIÓN 2: SISTEMA DE COMPRAS Y PUJAS (BOT -> JUGADOR)
###################################################################################################
#
#    BotAuction.AlwaysBuyPlayerItems
#        Descripción: Si se activa (1), el bot COMPRARÁ SIEMPRE los items de los jugadores.
#                     Si se desactiva (0), usará azar para decidir si puja o compra (Recomendado: 0).
BotAuction.AlwaysBuyPlayerItems = 1

#
#    BotAuction.ChanceToBuy
#        Descripción: Probabilidad (0-100) de que el bot compre un objeto directamente.
BotAuction.ChanceToBuy = 35

#
#    BotAuction.ChanceToBid
#        Descripción: Probabilidad (0-100) de que el bot haga una puja en tu objeto.
BotAuction.ChanceToBid = 60

#
#    BotAuction.MaxBuysPerCycle
#        Descripción: Límite de compras exitosas que el bot puede hacer en un solo ciclo.
BotAuction.MaxBuysPerCycle = 15

#
#    BotAuction.MinDelayMinutes
#        Descripción: Tiempo de espera antes de que el bot toque un item recién puesto.
BotAuction.MinDelayMinutes = 5

#
###################################################################################################
# SECCIÓN 3: CONTROL DE ECONOMÍA Y PRECIOS
###################################################################################################
#
#    BotAuction.MaxPlayerPriceMultiplier
#        Descripción: Multiplicador sobre el precio de venta al NPC. 
#                     Subido a 50.0 para aceptar precios de mercado de jugadores.
BotAuction.MaxPlayerPriceMultiplier = 10.0

#
#    BotAuction.MaxAbsolutePrice
#        Descripción: Precio máximo absoluto que el bot pagará (en cobre).
#                     Ejemplo: 10000000 = 1000 Oro.
BotAuction.MaxAbsolutePrice = 10000000

#
###################################################################################################
# SECCIÓN 4: IDENTIDAD DEL BOT (MÚLTIPLE)
###################################################################################################
#
#    BotAuction.DummyBidderList
#        Descripción: Lista de GUIDs de personajes separados por comas. 
#                     El bot elegirá uno al azar de esta lista para cada compra.
#                     IMPORTANTE: Estos personajes DEBEN existir en la tabla 'characters'.
BotAuction.DummyBidderList = 4002,4003,4005,4007,4010,4022

###################################################################################################