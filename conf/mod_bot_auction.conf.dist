###################################################################################################
# AZEROTHCORE - BOT AUCTION HOUSE MODULE - BYG80S (UPDATED)
###################################################################################################

[worldserver]

###################################################################################################
# GENERAL
###################################################################################################

# Habilitar o deshabilitar el módulo
BotAuction.Enable = 1

# Intervalo de actualización en milisegundos (30000 = 30 segundos)
BotAuction.UpdateInterval = 30000

###################################################################################################
# VENTAS DEL BOT (BOT -> AH)
###################################################################################################

# Máximo total de subastas creadas por bots en todas las casas de subastas
BotAuction.MaxBotAuctions = 800

# Cantidad de objetos que el bot intenta poner a la venta en cada ciclo
BotAuction.ItemsPerCycle = 10

# Máximo de subastas permitidas por cada casa individual (Horda, Alianza, Neutral)
BotAuction.MaxPerHouse = 700

###################################################################################################
# COMPRAS DEL BOT A JUGADORES (BOT -> PLAYER)
###################################################################################################

# Máximo de compras que el bot puede realizar en un solo ciclo (para no vaciar la AH de golpe)
BotAuction.MaxBuysPerCycle = 20

# ¿Comprar siempre al jugador? 
# 1 = El bot comprará casi todo lo que pongas (siempre que el precio sea justo).
# 0 = El bot usará la probabilidad definida en 'PlayerBuyChance'.
BotAuction.AlwaysBuyPlayerItems = 0

# Probabilidad (0-100) de que el bot decida comprar un objeto de un jugador en cada ciclo.
BotAuction.PlayerBuyChance = 80

# --- SISTEMA DE PRECIO JUSTO ---
# Multiplicador máximo sobre el precio base.
# Ejemplo: Si un item vale 10g y el multiplicador es 2.0, el bot NO comprará si el precio es > 20g.
# Esto evita que los jugadores abusen del bot con precios absurdos.
BotAuction.MaxPlayerPriceMultiplier = 2.0

# Si se pone en 1, el bot ignorará el precio y comprará cualquier cosa (No recomendado)
BotAuction.IgnorePlayerPrice = 0

###################################################################################################
# MERCADO INTERNO (BOT -> BOT)
###################################################################################################

# Probabilidad (0-100) de que un bot le compre a otro bot. 
# Sirve para que los objetos roten y la casa de subastas se mantenga limpia.
BotAuction.BotBuyChance = 30

# Ratio de precio utilizado en el mercado interno de bots.
BotAuction.BotBuyRatio = 0.8

###################################################################################################
# CONFIGURACIÓN DE BASE DE DATOS
###################################################################################################

# El bot utiliza la tabla 'bot_auction_items' en la base de datos 'world' (o la que indiques).
# Los bots SOLO crearán subastas de los items que estén en esa tabla.
# Los jugadores pueden vender CUALQUIER item, el bot los analizará según las reglas anteriores.
###################################################################################################